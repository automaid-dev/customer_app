<?xml version="1.0" encoding="utf-8"?>
<!-- Matches the app's own background color (see values/colors.xml) so
     there's no distinct "splash screen" flash before Getting Started —
     this native background is only ever visible for a moment while the
     Flutter engine boots, and now looks like a seamless continuation
     of the first Flutter frame rather than a separate screen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background_color" />
</layer-list>
